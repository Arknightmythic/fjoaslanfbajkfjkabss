# ==============================================================================
# Synchrono AI Chatbot Platform — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Configure your AI model credentials (Ollama Cloud, OpenRouter, Groq, etc.)
# 3. Configure the local JSONL trace file path below
# ==============================================================================

# ==============================================================================
# 1. Server & Network Configuration
# ==============================================================================
PORT=8000
HOST=0.0.0.0
# Allowed origins for frontend website integration (JSON array string)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]

# ==============================================================================
# 2. LLM Provider Configuration (ChatOpenAI / OpenAI-Compatible /v1 API)
# ==============================================================================
# The chatbot engine uses ChatOpenAI only. You can plug in any
# OpenAI-compatible LLM provider simply by setting these 3 variables.

# --- Option A: Ollama Cloud (Default & Recommended) ---
# Sign up at: https://ollama.com
OPENAI_BASE_URL=https://ollama.com/v1
OPENAI_MODEL_NAME=gemma4:31b-cloud
OPENAI_API_KEY=your_ollama_cloud_api_key_here

# --- Option B: Local Ollama (Running on your local machine) ---
# Start Ollama locally: ollama run gemma4:31b
# Note: In Docker on Windows/macOS, use http://host.docker.internal:11434/v1
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL_NAME=gemma4:31b-cloud
# OPENAI_API_KEY=ollama

# --- Option C: OpenRouter (Multi-model provider) ---
# Sign up at: https://openrouter.ai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL_NAME=google/gemini-2.0-flash-001
# OPENAI_API_KEY=sk-or-v1-your_openrouter_key

# --- Option D: Groq Cloud (Ultra-low latency inference) ---
# Sign up at: https://console.groq.com
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL_NAME=llama-3.3-70b-versatile
# OPENAI_API_KEY=gsk_your_groq_api_key

# --- Option E: Official OpenAI ---
# Sign up at: https://platform.openai.com
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL_NAME=gpt-4o-mini
# OPENAI_API_KEY=sk-your_openai_api_key

# --- Option F: DeepSeek Cloud ---
# Sign up at: https://platform.deepseek.com
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL_NAME=deepseek-chat
# OPENAI_API_KEY=sk-your_deepseek_api_key

# ==============================================================================
# 3. PostgreSQL Conversation & Chat History Storage (Internal DB)
# ==============================================================================
# Sesuai konfigurasi docker-compose.yml pada port 5433 (mencegah bentrok port 5432)
INTERNAL_HOST=127.0.0.1
INTERNAL_PORT=5433
INTERNAL_USER=synchrono
INTERNAL_PASSWORD=change_me_local
INTERNAL_DATABASE=synchrono_chatbot

# ==============================================================================
# SeaweedFS S3-compatible object storage (local development)
# ==============================================================================
SEAWEEDFS_ACCESS_KEY=change_me_s3_access
SEAWEEDFS_SECRET_KEY=change_me_s3_secret
SEAWEEDFS_BUCKET=chatbot-documents
KNOWLEDGE_INGEST_PREFIX=faq-inbox/
KNOWLEDGE_DOCUMENT_INGEST_PREFIX=document-inbox/
PGVECTOR_COLLECTION_NAME=synchrono_faq_docs
PGVECTOR_DOCUMENT_COLLECTION_NAME=synchrono_documents
DOCUMENT_RETRIEVAL_CANDIDATES=20
DOCUMENT_DIRECT_MIN_SCORE=0.0
S3_ENDPOINT_URL=http://127.0.0.1:8333
AWS_DEFAULT_REGION=us-east-1
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
SEMANTIC_CACHE_TTL_SECONDS=43200
SEMANTIC_CACHE_DOCUMENT_INDEX=idx:query_cache_document
SEMANTIC_CACHE_DOCUMENT_KEY_PREFIX=query_cache_document:

# ==============================================================================
# 4. Analytics Database (StarRocks Engine)
# ==============================================================================
# StarRocks MySQL-compatible endpoint (port 9030)
DB_HOST=127.0.0.1
DB_PORT=9030
DB_NAME=synchrono
DB_USER=synchrono_readonly
DB_PASSWORD=change_me_local
# Fail fast on stalled StarRocks queries and retry transient connection errors.
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=15
DB_MAX_RETRIES=2
# Short-lived cache for anomaly summaries; set 0 to disable.
ANOMALY_CACHE_TTL_SECONDS=30

# ==============================================================================
# 5. Local JSONL tracing
# ==============================================================================
CHATBOT_FILE_TRACE_ENABLED=true
CHATBOT_TRACE_FILE=/app/data/logs/chatbot-traces.jsonl
CHATBOT_TRACE_MAX_BYTES=10485760
CHATBOT_TRACE_BACKUP_COUNT=5
# Opik-style content capture: question/answer, LLM prompts/outputs, tool inputs/outputs.
# NIK values are still masked and payloads are truncated.
CHATBOT_TRACE_INCLUDE_CONTENT=true
CHATBOT_TRACE_PAYLOAD_MAX_CHARS=4000
# One nested JSON file per completed chat trace (Opik-style trace view).
CHATBOT_TRACE_WRITE_JSON=true
CHATBOT_TRACE_JSON_DIR=/app/data/logs/traces

# Daily WIB log archive to SeaweedFS: 23:00 snapshot for the current day,
# then 00:05 final archive for the previous day (Asia/Jakarta).
CHATBOT_LOG_BUCKET=chatbot-logs
CHATBOT_ANSWER_AUDIT_ENABLED=true

# ==============================================================================
# 6. Database Schema & Column Access Control
# ==============================================================================
# Note: Legacy configuration; not currently used or enforced by active connector tools.
# Format: table1:*,table2:col1,col2,... | table3:*
ALLOWED_DB_SCHEMA=uploaded_files:*,manual_matches:*,institution:file_id,id_incoming,match_score,match_result,upload_date,ref_grades:*,ref_sync_statuses:*,ref_match_results:*,grade_bands:*
