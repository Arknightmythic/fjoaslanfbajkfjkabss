# ==============================================================================
# Synchrono AI Chatbot Platform — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Configure your AI model credentials (Ollama Cloud, OpenRouter, Groq, etc.)
# 3. Configure Opik Cloud observability credentials (or set USE_OPIK=false)
# ==============================================================================

# ==============================================================================
# 1. Server & Network Configuration
# ==============================================================================
PORT=8000
HOST=0.0.0.0
# Allowed origins for frontend website integration (JSON array string)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]

# ==============================================================================
# 2. Universal LLM Provider Configuration (OpenAI-Compatible /v1 API)
# ==============================================================================
# The chatbot engine uses LangChain's universal factory. You can plug in any
# OpenAI-compatible LLM provider simply by setting these 3 variables.

# --- Option A: Ollama Cloud (Default & Recommended) ---
# Sign up at: https://ollama.com
OPENAI_BASE_URL=https://ollama.com/v1
OPENAI_MODEL_NAME=gemma4:31b-cloud
OPENAI_API_KEY=your_ollama_cloud_api_key_here

# --- Option B: Local Ollama (Running on your local machine) ---
# Start Ollama locally: ollama run gemma4:31b
# Note: In Docker on Windows/macOS, use http://host.docker.internal:11434/v1
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL_NAME=gemma4:31b-cloud
# OPENAI_API_KEY=ollama

# --- Option C: OpenRouter (Multi-model provider) ---
# Sign up at: https://openrouter.ai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL_NAME=google/gemini-2.0-flash-001
# OPENAI_API_KEY=sk-or-v1-your_openrouter_key

# --- Option D: Groq Cloud (Ultra-low latency inference) ---
# Sign up at: https://console.groq.com
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL_NAME=llama-3.3-70b-versatile
# OPENAI_API_KEY=gsk_your_groq_api_key

# --- Option E: Official OpenAI ---
# Sign up at: https://platform.openai.com
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL_NAME=gpt-4o-mini
# OPENAI_API_KEY=sk-your_openai_api_key

# --- Option F: DeepSeek Cloud ---
# Sign up at: https://platform.deepseek.com
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL_NAME=deepseek-chat
# OPENAI_API_KEY=sk-your_deepseek_api_key

# ==============================================================================
# 3. PostgreSQL Conversation & Chat History Storage
# ==============================================================================
# Sesuai konfigurasi docker-compose.yml pada port 5433 (mencegah bentrok port 5432)
POSTGRES_USER=synchrono
POSTGRES_PASSWORD=synchrono123
POSTGRES_DB=synchrono_chatbot
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# Connection URI for local host execution:
POSTGRES_URI=postgresql://synchrono:synchrono123@localhost:5433/synchrono_chatbot

# ==============================================================================
# 4. Analytics Data Matching Database (Source of Truth)
# ==============================================================================
# Connection URI ke database data matching analitik (uploaded_files, manual_matches, dll).
# Jika dikosongkan atau server database offline, sistem otomatis mengaktifkan
# in-memory mock SQLite berteknologi StaticPool dengan data sampel realistis.

# Pilihan A: PostgreSQL Analytics Database (misal di WSL/VM atau container remote)
# ANALYTICS_DB_URI=postgresql://synchrono_readonly:sync_ro_pass@localhost:5433/synchrono

# Pilihan B: StarRocks Engine
# ANALYTICS_DB_URI=mysql+pymysql://root:@localhost:9030/synchrono

# Pilihan C: Kosongkan untuk menggunakan built-in Mock SQLite otomatis
ANALYTICS_DB_URI=

# ==============================================================================
# 5. Opik Cloud Observability & LLM Tracing
# ==============================================================================
# Platform monitoring inferensi LLM, latensi SQL, jejak tool calls, dan token costs.
# Dapatkan API key gratis di: https://www.comet.com/opik
USE_OPIK=true
OPIK_API_KEY=your_opik_cloud_api_key_here
OPIK_PROJECT_NAME=synchrono-chatbot
OPIK_WORKSPACE=your_opik_workspace_or_username

# Untuk menonaktifkan Opik tracing (berjalan 100% lokal tanpa kirim telemetri):
# USE_OPIK=false

# ==============================================================================
# 6. Database Schema & Column Access Control
# ==============================================================================
# Tentukan tabel dan kolom yang diizinkan untuk diintrospeksi oleh agen analitik.
# Format: table1:*,table2:col1,col2,... | table3:*
# Gunakan '*' untuk mengizinkan semua kolom pada tabel tersebut.
ALLOWED_DB_SCHEMA=uploaded_files:*,manual_matches:*,institution:file_id,id_incoming,match_score,match_result,upload_date,ref_grades:*,ref_sync_statuses:*,ref_match_results:*,grade_bands:*
