# Setelan chatbot di kube yang BUKAN rahasia (ConfigMap synchrono-chatbot-config). Rahasia ada di
# kube/secret.env -> Secret synchrono-chatbot-secret. Arti tiap variabel: .env.example.
# Nilai model/gateway sama dengan deploy docker di 107.
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]

# LLM + embedding lewat ollama-proxies (docker di 107, tetap berjalan).
OPENAI_BASE_URL=http://192.168.2.107:11435/v1
OPENAI_MODEL_NAME=gemma4:31b
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=http://192.168.2.107:11435/v1
EMBEDDING_MODEL=openrouter/qwen/qwen3-embedding-8b

# PostgreSQL pgvector khusus chatbot (kube/pendukung).
INTERNAL_HOST=synchrono-chatbot-db
INTERNAL_PORT=5432
INTERNAL_USER=synchrono
INTERNAL_DATABASE=synchrono_chatbot

# Valkey bundle khusus chatbot (kube/pendukung): cache semantik di DB 0 (butuh modul search),
# broker Celery di DB 1.
VALKEY_HOST=synchrono-chatbot-valkey
VALKEY_PORT=6379
VALKEY_DB=0
CELERY_BROKER_URL=redis://synchrono-chatbot-valkey:6379/1
SEMANTIC_CACHE_TTL_SECONDS=43200
SEMANTIC_CACHE_DOCUMENT_INDEX=idx:query_cache_document
SEMANTIC_CACHE_DOCUMENT_KEY_PREFIX=query_cache_document:

# Arsip log harian dikerjakan worker di pod API (kube/chatbot.yaml, container log-archiver).
CHATBOT_LOG_QUEUE=chatbot_logs
CHATBOT_LOG_BUCKET=chatbot-logs

# SeaweedFS di cluster (namespace seaweedfs). Bucket dibuat otomatis bila belum ada.
S3_ENDPOINT_URL=http://seaweedfs.seaweedfs.svc.cluster.local:8333
S3_BUCKET=chatbot-documents
AWS_DEFAULT_REGION=us-east-1
KNOWLEDGE_INGEST_PREFIX=faq-inbox/
KNOWLEDGE_DOCUMENT_INGEST_PREFIX=document-inbox/
PGVECTOR_COLLECTION_NAME=synchrono_faq_docs
PGVECTOR_DOCUMENT_COLLECTION_NAME=synchrono_documents
DOCUMENT_RETRIEVAL_CANDIDATES=20
DOCUMENT_DIRECT_MIN_SCORE=0.0
KNOWLEDGE_INGEST_FILE_ENABLED=false

# StarRocks di cluster: tabel engine yang dibaca chatbot.
DB_HOST=starrocks.starrocks.svc.cluster.local
DB_PORT=9030
DB_NAME=syncrono_starrocks_v002
DB_USER=root
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=15
DB_MAX_RETRIES=2
DB_MAX_ROWS=200
ANOMALY_CACHE_TTL_SECONDS=30

CHATBOT_FILE_TRACE_ENABLED=true
CHATBOT_TRACE_FILE=/app/data/logs/chatbot-traces.jsonl
CHATBOT_TRACE_MAX_BYTES=10485760
CHATBOT_TRACE_BACKUP_COUNT=5
CHATBOT_TRACE_INCLUDE_CONTENT=true
CHATBOT_TRACE_PAYLOAD_MAX_CHARS=4000
CHATBOT_TRACE_WRITE_JSON=true
CHATBOT_TRACE_JSON_DIR=/app/data/logs/traces
CHATBOT_ANSWER_AUDIT_ENABLED=true
