# Salin ke kube/secret.env (di-.gitignore), isi, lalu:
#   kubectl -n syncrono create secret generic synchrono-chatbot-secret \
#     --from-env-file=kube/secret.env --dry-run=client -o yaml | kubectl apply -f -
# Secret ini harus ada SEBELUM kube/pendukung (PostgreSQL membaca INTERNAL_PASSWORD darinya).
# Setelah Secret berubah: kubectl -n syncrono rollout restart deploy -l app.kubernetes.io/name=synchrono-chatbot

# Kunci ollama-proxies (sama dengan .env chatbot di 107). EMBEDDING_API_KEY kosong = OPENAI_API_KEY.
OPENAI_API_KEY=
EMBEDDING_API_KEY=
# Sandi PostgreSQL chatbot; dipakai juga saat PostgreSQL pertama kali dibuat.
INTERNAL_PASSWORD=
# Sandi StarRocks untuk DB_USER.
DB_PASSWORD=
# Kunci SeaweedFS kube (kube.test.txt dari tim infra).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bila Valkey chatbot diberi password: isi ini dan timpa brokernya.
# VALKEY_PASSWORD=
# CELERY_BROKER_URL=redis://:<password>@synchrono-chatbot-valkey:6379/1
